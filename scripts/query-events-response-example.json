          "headline": "Thanks for Registering!",
          "message": "<strong>Please remember to fill out our pre-event sentiment survey at the time you enter the event</strong>.  This helps us see how the conversations impact participants' attitudes towards each other.",
          "type": "preEvent",
          "surveyQuestions": [
            {

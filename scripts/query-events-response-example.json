              "title": "Thinking about your own life, do you believe\u2026",
              "options": [
                {
                  "id": "019dee2f-7c53-478c-9673-cfc2390bcef5",
                  "text": "I\u2019ve achieved the American Dream."
                },
                {
                  "id": "edcb725f-12f9-44ce-9fb5-045c7bd33c04",
                  "text": "I\u2019m on my way to achieving the American Dream."
                },
                {
                  "id": "8e91a967-0b03-4b17-88b4-dc56a8fbdca5",
                  "text": "The American Dream is out of reach for me."
                },
                {
                  "id": "d7506adf-7bed-453f-9e96-dbf4dc098cfb",
                  "text": "Unsure"
                }
              ],
              "statements": []
            },
            {
              "id": "c97c1dc3-d269-4a8e-8484-d55d94129da6",
              "type": "agreeDisagree",
              "title": "",
              "options": [],
              "statements": [
                {
                  "id": "b4bf41a7-2bc3-4486-8d98-70b9f0fc380c",
                  "text": "The American Dream can be achieved by people like me."
                },
                {
                  "id": "df058b3a-a8a3-4178-be74-612d2d98492b",
                  "text": "There's a point in modern American life where building financial security matters more than taking risks to get ahead."
                },
                {
                  "id": "03c43cbc-eecc-4248-b9e4-ec8aa34162ba",
                  "text": "I can achieve a better life than my parents\u2019 generation."
                },
                {
                  "id": "c5e8b052-24c7-489a-b8be-1e9bf6976f6e",
                  "text": "Financial security is determined more by financial habits and decisions than by income level."
                },
                {
                  "id": "354d6866-4d67-4e27-8929-83135193948e",
                  "text": "It is important that people strive for the American Dream."
                },
                {
                  "id": "b2d5f51a-6b7a-4492-afc5-1a612d3ac898",
                  "text": "Financial risk is necessary to achieve the American Dream."
                },
                {
                  "id": "4a9cb440-7dc1-4c0a-84ee-1995d4e19dc9",
                  "text": "I respect others' opinions even when I do not agree."
                },
                {
                  "id": "08d7b003-3261-45b8-a6fc-3e3d5d98756e",
                  "text": "I accept that my beliefs may be wrong."
                }
              ]
